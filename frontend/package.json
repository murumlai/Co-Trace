{
  "name": "cotrace-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "dev:debug": "node scripts/dev-server.mjs --debug",
    "test": "npm run test:unit && npm run test:component",
    "test:browser": "playwright test",
    "test:unit": "node --test src/diagnosisPresentation.test.js src/evidenceReferences.test.js src/jobMonitoring.test.js src/logEvidence.test.js src/managerMetrics.test.js src/managerReport.test.js src/unitAttempts.test.js src/uploadSelection.test.js src/workspaceState.test.js",
    "test:component": "vitest run src/pages/Engineer.render.test.jsx src/App.render.test.jsx",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.1.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8",
    "vitest": "^2.1.9"
  }
}
